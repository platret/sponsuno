# Response headers for Cloudflare Workers static assets (copied to dist/_headers, not served as a file).

# Hashed build output: cache for a year
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Clickable demo with fictional data: keep it out of search results (backup for its meta robots noindex).
# Not blocked in robots.txt on purpose: crawlers must fetch it to see the noindex.
/demo/*
  X-Robots-Tag: noindex

# Word versions of the guide templates (written by scripts/prerender.mjs). Same URL after a text change, so cache
# briefly; noindex keeps the files out of search results (the guide pages are what should be found).
/vorlagen/*
  Cache-Control: public, max-age=3600
  X-Robots-Tag: noindex

# Images and fonts of the waitlist e-mails (emails/, npm run emails). Fixed URLs referenced from sent e-mails, so
# they never move; the fonts need CORS because mail clients load them from another origin.
/email/*
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex

# Every response. HTTPS only (HSTS without includeSubDomains/preload: keeps the Infomaniak mail hostnames out of it),
# no MIME sniffing, only the origin as referrer to other sites, no framing (not even by the site itself), and no camera, microphone,
# location or Topics API (the site uses none of them). No Content-Security-Policy for now: the inline scripts and the
# JSON-LD would need hashes first.
/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), browsing-topics=()
