{
  "name": "sponsuno",
  "compatibility_date": "2026-10-20",
  // Unknown URLs get dist/404.html (prerendered from src/pages.ts, id "notfound") with status 404
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [
    { "pattern": "sponsuno.ch", "custom_domain": true },
    { "pattern": "www.sponsuno.ch", "custom_domain": true }
  ],
  "preview_urls": true,
  "previews": {},
  "observability": { "enabled": false }
}
